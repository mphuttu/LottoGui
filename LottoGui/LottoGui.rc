/////////////////////////////////////////////////////////////////////////////
// Finnish (Finland) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_FIN)
LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&Tiedosto"
    BEGIN
        MENUITEM "&Uusi\tCtrl+N",               ID_FILE_NEW
        MENUITEM "&Avaa... \tCtrl+O",           ID_FILE_OPEN
        MENUITEM "&Tallenna\tCtrl+S",           ID_FILE_SAVE
        MENUITEM "Tallenna &nimellä...",       ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Tulosta...\tCtrl+P",         ID_FILE_PRINT
        MENUITEM "Esika&tselu",                 ID_FILE_PRINT_PREVIEW
        MENUITEM "Tulos&tusasetukset...",       ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Viimeinen tiedosto",          ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Lopeta",                     ID_APP_EXIT
    END
    POPUP "&Lotto-asetukset"
    BEGIN
        MENUITEM "Klassinen lotto...",          ID_LOTTOOPTIONS
        MENUITEM "Suomen Lotto CSV...",         ID_LOTTOOPTIONS_SUOMENLOTTO
        MENUITEM "Milli CSV...",                ID_LOTTOOPTIONS_MILLICSV
        MENUITEM "KTEM CSV...",                 ID_LOTTOOPTIONS_KTEMCSV
        MENUITEM "Keno CSV...",                 ID_LOTTOOPTIONS_KENOCSV
        MENUITEM "Eurojackpot CSV...",          ID_LOTTOOPTIONS_EUROJACKPOTCSV
        MENUITEM "Viking Lotto CSV...",         ID_LOTTOOPTIONS_VIKINGLOTTOCSV
        MENUITEM "Jokeri CSV...",               ID_LOTTOOPTIONS_JOKERICSV
        MENUITEM "Tarkista osumat...",          ID_LOTTOOPTIONS_CHECKRESULTS
    END
    POPUP "&Muokkaa"
    BEGIN
        MENUITEM "&Kumoa        Ctrl+Z",        ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "&Leikkaa      Ctrl+X",        ID_EDIT_CUT
        MENUITEM "&Kopioi       Ctrl+C",        ID_EDIT_COPY
        MENUITEM "&Liitä        Ctrl+V",        ID_EDIT_PASTE
    END
    POPUP "Näytä"
    BEGIN
        MENUITEM "&Työkalurivi",               ID_VIEW_TOOLBAR
        MENUITEM "&Tilapalkki",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Ohje"
    BEGIN
        MENUITEM "Käyttöohje...",             ID_HELP_USAGE
        MENUITEM SEPARATOR
        MENUITEM "&Tietoja LottoGui:sta...",    ID_APP_ABOUT
    END
END


