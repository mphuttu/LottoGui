IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Print Pre&view",              ID_FILE_PRINT_PREVIEW
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Lotto-valinnat"
    BEGIN
        MENUITEM "Klassinen Lotto -asetukset...",    ID_LOTTOOPTIONS
        MENUITEM "Suomen Lotto CSV...",              ID_LOTTOOPTIONS_SUOMENLOTTO
        MENUITEM "Milli CSV...",                     ID_LOTTOOPTIONS_MILLICSV
        MENUITEM "KTEM CSV...",                      ID_LOTTOOPTIONS_KTEMCSV
        MENUITEM "Keno CSV...",                      ID_LOTTOOPTIONS_KENOCSV
        MENUITEM "Eurojackpot CSV...",               ID_LOTTOOPTIONS_EUROJACKPOTCSV
        MENUITEM "Viking Lotto CSV...",              ID_LOTTOOPTIONS_VIKINGLOTTOCSV
        MENUITEM "Jokeri CSV...",                    ID_LOTTOOPTIONS_JOKERICSV
        MENUITEM "Tarkista tulokset...",             ID_LOTTOOPTIONS_CHECKRESULTS
    END
    POPUP "&Muokkaa"
    BEGIN
        MENUITEM "&Peruuta\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Leikkaa\tCtrl+X",               ID_EDIT_CUT
        MENUITEM "&Kopioi\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Liitä\tCtrl+V",                ID_EDIT_PASTE
    END
    POPUP "&Näytä"
    BEGIN
        MENUITEM "&Työkalurivi",                   ID_VIEW_TOOLBAR
        MENUITEM "&Tilarivi",                      ID_VIEW_STATUS_BAR
    END
    POPUP "&Ohje"
    BEGIN
        MENUITEM "&Käyttöohje...",                 ID_HELP_USAGE
        MENUITEM SEPARATOR
        MENUITEM "&Tietoja LottoGuista...",         ID_APP_ABOUT
    END
END


